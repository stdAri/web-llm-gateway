{
  "name": "web-llm-gateway",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stdAri/web-llm-gateway"
  },
  "description": "Local Gateway Node presenting standard model protocols to Agent Clients while using authenticated consumer AI Web Products as upstream backends.",
  "scripts": {
    "serve": "bun run src/daemon/index.ts serve",
    "dev": "bun run src/daemon/index.ts serve",
    "pair": "bun run src/daemon/index.ts pair",
    "test": "bun test --path-ignore-patterns=**/reference/**",
    "typecheck": "tsc --noEmit",
    "build:bridge": "bun run scripts/build-bridge.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
